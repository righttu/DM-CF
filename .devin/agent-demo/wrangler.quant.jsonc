{
  "name": "abc-quant-mcp-s",
  "main": "../../apps/agent-demo/src/quant/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "ebc4f70211dc33165a239c6018da8e2d",
  "keep_vars": true,
  "workers_dev": false,
  "routes": [
    { "pattern": "abc-quant-mcp-s.righttu.uk", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "durable_objects": {
    "bindings": [
      { "name": "CONSENT_TRANSACTIONS", "class_name": "ConsentTransaction" },
      { "name": "EMBEDDING", "class_name": "QuantEmbeddingContainer" },
      { "name": "ANALYSIS", "class_name": "QuantAnalysisContainer" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ConsentTransaction", "QuantEmbeddingContainer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["QuantAnalysisContainer"]
    }
  ],
  "containers": [
    {
      "class_name": "QuantEmbeddingContainer",
      "name": "abc-quant-embedding-container",
      "image": "../../apps/agent-demo/container/embedding/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 2
    },
    {
      "class_name": "QuantAnalysisContainer",
      "name": "abc-quant-analysis-container",
      "image": "../../apps/agent-demo/container/analysis/Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 3
    }
  ],
  "r2_buckets": [
    { "binding": "R2_STOCK_INFOR", "bucket_name": "stock-infor" }
  ],
  "d1_databases": [
    {
      "binding": "QUANT_DB",
      "database_name": "quant-data",
      "database_id": "85914a38-2ba4-4e85-b229-e1e1a043a266"
    },
    {
      "binding": "AUDIT_DB",
      "database_name": "abc-audit",
        "database_id": "9eac7020-e816-4095-947d-4829df2b6e88",
      "migrations_dir": "../../apps/agent-demo/migrations/audit"
    }
  ],
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "stock-knowledge" }
  ],
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "3e6db718bcf84164b3fffbd483156555" }
  ],
  "vars": {
    "TEAM_DOMAIN": "https://righttu.cloudflareaccess.com",
    "MCP_AUTHORIZE_ACCESS_AUD": "8e49e8855f422256e227ad66632a33477839f4de231759fd398061476182513d",
    "PUBLIC_MCP_ORIGIN": "https://abc-quant-mcp-s.righttu.uk",
    "ALLOWED_ORIGINS": "https://agent-demo.righttu.uk,https://portal-demo.righttu.uk",
    "ENVIRONMENT": "production",
    "CF_ACCOUNT_ID": "ebc4f70211dc33165a239c6018da8e2d",
    "AI_GATEWAY_ID": "ai-gateway",
    "AUDIT_SERVICE_NAME": "abc-quant-mcp-s",
    "AUDIT_D1_NAME": "quant-data",
    "AUDIT_VECTORIZE_NAME": "stock-knowledge",
    "AUDIT_R2_NAME": "stock-infor"
  },
  "env": {
    "local": {
      "durable_objects": {
        "bindings": [
          { "name": "CONSENT_TRANSACTIONS", "class_name": "ConsentTransaction" },
          { "name": "EMBEDDING", "class_name": "QuantEmbeddingContainer" },
          { "name": "ANALYSIS", "class_name": "QuantAnalysisContainer" }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["ConsentTransaction", "QuantEmbeddingContainer"]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["QuantAnalysisContainer"]
        }
      ],
      "d1_databases": [
        {
          "binding": "QUANT_DB",
          "database_name": "quant-data-local",
          "database_id": "local-quant-db"
        },
        {
          "binding": "AUDIT_DB",
          "database_name": "audit-db-local",
          "database_id": "local-audit-db",
          "migrations_dir": "../../apps/agent-demo/migrations/audit"
        }
      ],
      "vectorize": [
        { "binding": "VECTORIZE", "index_name": "stock-knowledge-local" }
      ],
      "ai": { "binding": "AI" },
      "r2_buckets": [
        { "binding": "R2_STOCK_INFOR", "bucket_name": "stock-infor-local" }
      ],
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "local-quant-oauth-kv" }
      ],
      "vars": {
        "ENVIRONMENT": "local",
        "PUBLIC_MCP_ORIGIN": "http://localhost:8789",
        "ALLOWED_ORIGINS": "http://localhost:8787",
        "TEAM_DOMAIN": "https://local.invalid",
        "MCP_AUTHORIZE_ACCESS_AUD": "local-quant-aud",
        "ANALYST_EMAILS": "analyst@local.test",
        "VIEWER_EMAILS": "viewer@local.test",
        "LOCAL_DEV_IDENTITY_ENABLED": "true",
        "LOCAL_ANALYST_EMAIL": "analyst@local.test",
        "LOCAL_VIEWER_EMAIL": "viewer@local.test",
        "CF_ACCOUNT_ID": "local-account",
        "AI_GATEWAY_ID": "ai-gateway",
        "AUDIT_SERVICE_NAME": "abc-quant-mcp-s-local",
        "AUDIT_D1_NAME": "quant-data-local",
        "AUDIT_VECTORIZE_NAME": "stock-knowledge-local",
        "AUDIT_R2_NAME": "stock-infor-local"
      }
    }
  }
}
