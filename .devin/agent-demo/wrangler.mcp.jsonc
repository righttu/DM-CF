{
  "name": "agent-demo-mcp",
  "main": "../../apps/agent-demo/src/mcp/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "ebc4f70211dc33165a239c6018da8e2d",
  "workers_dev": false,
  "routes": [
    { "pattern": "mcp-demo.righttu.uk", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "d1_databases": [
    {
      "binding": "DEMO_DB",
      "database_name": "demo-agent-db",
      "database_id": "52a8d901-e4fe-4234-8d0c-e28179a56b8e",
      "migrations_dir": "../../apps/agent-demo/migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "40692a26799d4365aacbd534a9e509c8" },
    { "binding": "CONSENT_KV", "id": "5156c98767de48908e1ae13a2863c650" }
  ],
  "vars": {
    "TEAM_DOMAIN": "https://righttu.cloudflareaccess.com",
    "MCP_AUTHORIZE_ACCESS_AUD": "552cb8760d3d458fe1bcb705faa276d73630e9f1293e7cac871f1edd77168cf2",
    "PUBLIC_MCP_ORIGIN": "https://mcp-demo.righttu.uk",
    "ALLOWED_ORIGINS": "https://agent-demo.righttu.uk,https://portal-demo.righttu.uk",
    "ANALYST_EMAILS": "",
    "VIEWER_EMAILS": "",
    "ENVIRONMENT": "production"
  },
  "env": {
    "local": {
      "d1_databases": [
        {
          "binding": "DEMO_DB",
          "database_name": "demo-agent-db-local",
          "database_id": "local-demo-agent-db",
          "migrations_dir": "../../apps/agent-demo/migrations"
        }
      ],
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "local-oauth-kv" },
        { "binding": "CONSENT_KV", "id": "local-consent-kv" }
      ],
      "vars": {
        "ENVIRONMENT": "local",
        "PUBLIC_MCP_ORIGIN": "http://localhost:8788",
        "ALLOWED_ORIGINS": "http://localhost:8787",
        "TEAM_DOMAIN": "https://local.invalid",
        "MCP_AUTHORIZE_ACCESS_AUD": "local-mcp-aud",
        "ANALYST_EMAILS": "analyst@local.test",
        "VIEWER_EMAILS": "viewer@local.test",
        "LOCAL_DEV_IDENTITY_ENABLED": "true",
        "LOCAL_ANALYST_EMAIL": "analyst@local.test",
        "LOCAL_VIEWER_EMAIL": "viewer@local.test"
      }
    }
  }
}
