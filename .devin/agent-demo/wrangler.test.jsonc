{
  "name": "agent-demo-test",
  "main": "../../apps/agent-demo/test/entry.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "ResearchAgent", "class_name": "ResearchAgent" },
      { "name": "CONSENT_TRANSACTIONS", "class_name": "ConsentTransaction" },
      { "name": "ANALYSIS", "class_name": "QuantAnalysisContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ResearchAgent"] },
    { "tag": "v1-consent", "new_sqlite_classes": ["ConsentTransaction"] },
    { "tag": "v1-analysis", "new_sqlite_classes": ["QuantAnalysisContainer"] }
  ],
  "d1_databases": [
    {
      "binding": "DEMO_DB",
      "database_name": "demo-agent-db-test",
      "database_id": "demo-agent-db-test",
      "migrations_dir": "../../apps/agent-demo/migrations"
    },
    {
      "binding": "QUANT_DB",
      "database_name": "quant-db-test",
      "database_id": "quant-db-test"
    }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "test-oauth-kv" },
    { "binding": "CONSENT_KV", "id": "test-consent-kv" },
    { "binding": "CALLBACK_KV", "id": "test-callback-kv" }
  ],
  "vars": {
    "ENVIRONMENT": "local",
    "TEAM_DOMAIN": "https://team.example.test",
    "AGENT_ACCESS_AUD": "test-agent-aud",
    "MCP_AUTHORIZE_ACCESS_AUD": "test-mcp-aud",
    "PUBLIC_ORIGIN": "http://localhost",
    "PUBLIC_MCP_ORIGIN": "http://localhost",
    "ALLOWED_ORIGINS": "http://localhost",
    "ANALYST_EMAILS": "analyst@example.com",
    "VIEWER_EMAILS": "viewer@example.com",
    "MCP_SERVER_URL": "http://localhost/mcp",
    "ACCOUNT_ID": "test-account",
    "GATEWAY_ID": "test-gateway",
    "MODEL_ID": "@cf/zai-org/glm-5.3-flash",
    "DASHSCOPE_API_KEY": "test-dashscope-key",
    "CF_AIG_TOKEN": "test-aig-token",
    "ACCESS_TEST_JWKS_JSON": "{\"keys\":[{\"kty\":\"RSA\",\"n\":\"sId9Bo01-FfSxOU4i1oOZr630Qa-7K4yWKkdl5eiEZjWR8aFfb2mGzt5k9Hllw5UUSrkUrq-BN1f08SVLjt-ufFrQ6XK4Asc4IFo58Ed4WteED0ovJ44Rhdjvb_SHkZDUaoeJmhhlQ67ZBWkRlWSA5c2jZpTurcaUc0LLkMsHZZH3LhOaiZ8BIOZZe2u1IBn4IKp3oi-DcEjdnKdPUr8ZQ51bHuDdYI_EWyd595YVFSWk1Os3203-q6_577Uec-suqlw-FoYvDsWUkZnB5pW03zFGe8V25KW8GyUa8rH16tS_bRgxOhwPncD_YKUgXGXQs31ZrL8StvmEBnDKl3n7Q\",\"e\":\"AQAB\",\"kid\":\"test-key-1\",\"alg\":\"RS256\",\"use\":\"sig\"}]}",
    "LOCAL_DEV_IDENTITY_ENABLED": "false"
  }
}
