{
  "name": "agent-demo-frontend",
  "main": "../../apps/agent-demo/src/agent/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "ebc4f70211dc33165a239c6018da8e2d",
  "keep_vars": true,
  "workers_dev": false,
  "routes": [
    { "pattern": "agent-demo.righttu.uk", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "ResearchAgent", "class_name": "ResearchAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ResearchAgent"] }
  ],
  "kv_namespaces": [
    { "binding": "CALLBACK_KV", "id": "1fa8c3f84ff44ddda1e9a9764b981fb0" }
  ],
  "d1_databases": [
    {
      "binding": "AUDIT_DB",
      "database_name": "abc-audit",
      "database_id": "9eac7020-e816-4095-947d-4829df2b6e88",
      "migrations_dir": "../../apps/agent-demo/migrations/audit"
    }
  ],
  "vars": {
    "TEAM_DOMAIN": "https://righttu.cloudflareaccess.com",
    "AGENT_ACCESS_AUD": "82ba84b6961e0a2deb1eb0e40c5a57f40ae90d2c45586db370a089200a673ed0",
    "PUBLIC_ORIGIN": "https://agent-demo.righttu.uk",
    "MCP_SERVER_URL": "https://portal-demo.righttu.uk/mcp",
    "ACCOUNT_ID": "ebc4f70211dc33165a239c6018da8e2d",
    "GATEWAY_ID": "agent-demo",
    "MODEL_ID": "dynamic/abc-agent",
    "AUDIT_SERVICE_NAME": "agent-demo-frontend",
    "ENVIRONMENT": "production"
  },
  "env": {
    "local": {
      "ai": { "binding": "AI" },
      "durable_objects": {
        "bindings": [
          { "name": "ResearchAgent", "class_name": "ResearchAgent" }
        ]
      },
      "kv_namespaces": [
        { "binding": "CALLBACK_KV", "id": "local-callback-kv" }
      ],
      "d1_databases": [
        {
          "binding": "AUDIT_DB",
          "database_name": "audit-db-local",
          "database_id": "local-audit-db",
          "migrations_dir": "../../apps/agent-demo/migrations/audit"
        }
      ],
      "vars": {
        "ENVIRONMENT": "local",
        "PUBLIC_ORIGIN": "http://localhost:8787",
        "TEAM_DOMAIN": "https://local.invalid",
        "AGENT_ACCESS_AUD": "local-agent-aud",
        "MCP_SERVER_URL": "http://localhost:8788/mcp",
        "ACCOUNT_ID": "REPLACE_ME_ACCOUNT_ID",
        "GATEWAY_ID": "REPLACE_ME_GATEWAY_ID",
        "MODEL_ID": "@cf/zai-org/glm-5.3-flash",
        "ANALYST_EMAILS": "analyst@local.test",
        "VIEWER_EMAILS": "viewer@local.test",
        "LOCAL_DEV_IDENTITY_ENABLED": "true",
        "AUDIT_ADMIN_EMAILS": "audit-admin@local.test",
        "LOCAL_ANALYST_EMAIL": "analyst@local.test",
        "LOCAL_VIEWER_EMAIL": "viewer@local.test",
        "AUDIT_SERVICE_NAME": "agent-demo-frontend-local"
      }
    }
  }
}
