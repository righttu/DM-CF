{
  "name": "agent-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:agent": "wrangler dev -c ../../.devin/agent-demo/wrangler.agent.jsonc",
    "dev:mcp": "wrangler dev -c ../../.devin/agent-demo/wrangler.mcp.jsonc",
    "dev:agent:local": "wrangler dev -c ../../.devin/agent-demo/wrangler.agent.jsonc --env local --port 8787",
    "dev:mcp:local": "wrangler dev -c ../../.devin/agent-demo/wrangler.mcp.jsonc --env local --port 8788",
    "check": "tsc --noEmit -p ../../.devin/agent-demo/tsconfig.json",
    "test": "vitest run -c ../../.devin/agent-demo/vitest.config.ts",
    "check:build": "wrangler deploy -c ../../.devin/agent-demo/wrangler.agent.jsonc --env='' --dry-run && wrangler deploy -c ../../.devin/agent-demo/wrangler.mcp.jsonc --env='' --dry-run",
    "db:local:migrate": "wrangler d1 execute demo-agent-db-local -c ../../.devin/agent-demo/wrangler.mcp.jsonc --env local --local --file=./migrations/0001_demo.sql",
    "setup:config": "node scripts/ensure-config-node-modules.mjs",
    "postinstall": "node scripts/ensure-config-node-modules.mjs",
    "deploy:agent": "wrangler deploy -c ../../.devin/agent-demo/wrangler.agent.jsonc --env=''",
    "deploy:mcp": "wrangler deploy -c ../../.devin/agent-demo/wrangler.mcp.jsonc --env=''"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.81",
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@opentelemetry/api": "1.9.0",
    "agents": "0.26.0",
    "ai": "6.0.301",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20261005.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
